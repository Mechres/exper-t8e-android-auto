# Optional own access point (exper-ap service, disabled by default; see HANDOFF.md section 5b for why the phone hotspot is used instead).
# Copy to /etc/exper-auto/hostapd.conf and set a real passphrase.
# Exper-Auto in-car Wi-Fi Hotspot
interface=wlan0
driver=nl80211
ssid=Exper-Auto
hw_mode=g
channel=6
ieee80211n=1
wmm_enabled=1
ht_capab=[SHORT-GI-20]
auth_algs=1
wpa=2
wpa_key_mgmt=WPA-PSK
rsn_pairwise=CCMP
wpa_passphrase=<ap password>
