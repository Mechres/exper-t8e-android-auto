#!/sbin/openrc-run
description="Lift the AXP221 VBUS input current limit (default 500 mA) so USB can charge under load"
depend() {
	need localmount
}
start() {
	# VBUS path register 0x30 bits 1:0 -> "no limit"; the 4.4 V VHOLD still protects a weak host port
	echo 900000 > /sys/class/power_supply/axp20x-usb/input_current_limit
}
